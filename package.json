{
  "name": "our-space",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:requirements": "python -m unittest discover -s scripts -p test_*.py -v",
    "db:start": "python scripts/local_db.py start",
    "db:stop": "python scripts/local_db.py stop",
    "db:migrate": "python scripts/migrate_db.py",
    "test:db": "python scripts/integration_db.py",
    "test:e2e": "playwright test",
    "db:seed": "python scripts/seed_local.py",
    "db:runtime": "python scripts/provision_runtime.py",
    "test:database": "vitest run --config vitest.database.config.mjs",
    "auth:start": "python scripts/local_auth.py start",
    "auth:stop": "python scripts/local_auth.py stop",
    "test:auth-env": "python scripts/integration_auth_environment.py",
    "test:auth": "vitest run --config vitest.auth.config.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
