# Configure local-only application access in .env.local during the Auth stage.
# Never put the database owner account or service-role key in a NEXT_PUBLIC variable.
DATABASE_URL=
APP_ORIGIN=
SUPABASE_AUTH_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only 32 random bytes encoded as base64url; never reuse Auth signing key.
RECOVERY_COOKIE_KEY=
